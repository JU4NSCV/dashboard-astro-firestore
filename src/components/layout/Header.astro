---
import NavMenu from "./NavMenu.jsx";
const currentPath = Astro.url.pathname;
// El middleware ya verificó la cookie de sesión firmada
const isAuthenticated = Boolean(Astro.locals.user);
---

<header
  class="fixed top-0 left-0 right-0 z-50 bg-[#0b0f19]/80 backdrop-blur-xl border-b border-white/10 shadow-2xl"
>
  <div class="relative max-w-7xl mx-auto px-4 md:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo y Marca -->
      <a href="/" class="flex-shrink-0 flex items-center gap-3" aria-label="DatosFísica, ir al inicio">
        <div
          class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-cyan-500 flex items-center justify-center text-white shadow-lg shadow-indigo-500/30"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <span
          class="text-2xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400 tracking-tight hidden sm:block"
        >
          DatosFísica
        </span>
      </a>

      <!-- Navegación -->
      <NavMenu client:load currentPath={currentPath} isAuthenticated={isAuthenticated} />
    </div>
  </div>
</header>
