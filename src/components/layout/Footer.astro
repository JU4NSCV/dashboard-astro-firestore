---
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-700/50 py-8 px-4 md:px-8 bg-slate-900/30 backdrop-blur-md">
    <div
        class="max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-center text-sm text-slate-400 gap-4 text-center md:text-left"
    >
        <p>© {year} Club de Realidad Virtual. Todos los derechos reservados.</p>
        <div class="flex items-center gap-4">
            <a
                href="https://piper-ka.itch.io/proyectofisica"
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-slate-200 transition-colors duration-200">Simulador en itch.io</a
            >
            <span class="text-slate-500">v1.1.0</span>
        </div>
    </div>
</footer>
