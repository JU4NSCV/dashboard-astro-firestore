---
import "../styles/global.css";
import Header from "../components/Header.astro";

interface Props {
	title?: string;
}

const { title = "Dashboard Física" } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body
		class="bg-[#0b0f19] text-slate-200 min-h-screen flex flex-col font-sans antialiased selection:bg-indigo-500 selection:text-white"
	>
		<Header />
		<main class="flex-1 pt-24 pb-8">
			<slot />
		</main>
	</body>
</html>
