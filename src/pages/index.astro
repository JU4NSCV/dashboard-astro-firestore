---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Simulador de Tiros Parabólicos | Proyecto de Física">
    <!-- Hero Section -->
    <section
        class="relative min-h-[80vh] flex flex-col justify-center items-center overflow-hidden py-20"
    >
        <!-- Luces de fondo (Background Glows) -->
        <div
            class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] md:w-[800px] md:h-[800px] bg-indigo-600/20 rounded-full blur-[120px] pointer-events-none"
        >
        </div>
        <div
            class="absolute top-1/3 left-1/3 w-[400px] h-[400px] md:w-[500px] md:h-[500px] bg-cyan-500/20 rounded-full blur-[100px] pointer-events-none"
        >
        </div>

        <div class="relative z-10 max-w-5xl mx-auto px-4 text-center">
            <div
                class="inline-block mb-6 px-4 py-1.5 rounded-full bg-slate-800/50 border border-slate-700 backdrop-blur-md"
            >
                <span
                    class="text-xs md:text-sm font-semibold tracking-wider text-cyan-400 uppercase"
                    >Proyecto Educativo de Física</span
                >
            </div>

            <h1
                class="text-5xl md:text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-br from-white via-indigo-200 to-cyan-400 mb-8 tracking-tight leading-tight"
            >
                Domina el Tiro Parabólico <br class="hidden md:block" /> Jugando
            </h1>

            <p
                class="text-lg md:text-2xl text-slate-400 mb-12 max-w-3xl mx-auto leading-relaxed"
            >
                Un simulador interactivo creado en <span
                    class="text-white font-semibold">Unity</span
                >. Diseñado para que los estudiantes pongan a prueba sus
                conocimientos de cinemática en un entorno 3D divertido,
                educativo y realista.
            </p>

            <div
                class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6"
            >
                <a
                    href="https://piper-ka.itch.io/proyectofisica"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group relative px-8 py-4 bg-gradient-to-r from-indigo-500 to-cyan-500 rounded-2xl font-bold text-lg text-white shadow-lg shadow-indigo-500/30 hover:shadow-cyan-500/40 hover:-translate-y-1 transition-all duration-300 w-full sm:w-auto flex items-center justify-center gap-3"
                >
                    <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"
                        ><path
                            d="M19.141 3.52c-.752.022-1.742.34-2.825 1.054l-5.694 3.737c-1.353.887-1.585 2.502-.55 3.551l3.328 3.324c1.036 1.048 2.651.815 3.538-.538l3.743-5.69c1.018-1.547.458-3.056-.997-3.901a5.617 5.617 0 0 0-1.127-.674c-.201-.088-.415-.165-.63-.223a5.556 5.556 0 0 0-1.18-.396c-.198-.035-.4-.055-.6-.065zm-15.01 4.542a2.02 2.02 0 0 0-1.408 2.217l1.054 5.694c.189 1.018 1.157 1.624 2.181 1.405l5.694-1.054c1.018-.189 1.624-1.157 1.405-2.181l-1.054-5.694c-.189-1.018-1.157-1.624-2.181-1.405l-5.691 1.018z"
                        ></path></svg
                    >
                    Jugar en Itch.io
                    <div
                        class="absolute inset-0 rounded-2xl bg-white/20 opacity-0 group-hover:opacity-100 transition-opacity"
                    >
                    </div>
                </a>

                <a
                    href="/tests"
                    class="px-8 py-4 bg-slate-800/80 hover:bg-slate-700/80 border border-slate-600 rounded-2xl font-bold text-lg text-white backdrop-blur-md hover:-translate-y-1 transition-all duration-300 w-full sm:w-auto flex items-center justify-center gap-2"
                >
                    <svg
                        class="w-5 h-5 text-slate-300"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                        ></path></svg
                    >
                    Ver Resultados
                </a>
            </div>
        </div>
    </section>

    <!-- Sección de Características -->
    <section class="max-w-7xl mx-auto px-4 py-16 md:py-24 relative z-10">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
                ¿Por qué usar este simulador?
            </h2>
            <p class="text-slate-400 max-w-2xl mx-auto text-lg">
                Una herramienta complementaria perfecta para las clases de
                física que une la teoría con la práctica interactiva.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <!-- Feature 1 -->
            <div
                class="bg-slate-800/40 border border-slate-700/50 p-8 rounded-3xl backdrop-blur-sm hover:bg-slate-800/60 hover:-translate-y-2 transition-all duration-300 group shadow-lg"
            >
                <div
                    class="w-14 h-14 bg-indigo-500/20 rounded-2xl flex items-center justify-center text-indigo-400 mb-6 group-hover:scale-110 transition-transform"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M14 10l-2 1m0 0l-2-1m2 1v2.5M20 7l-2 1m2-1l-2-1m2 1v2.5M14 4l-2-1-2 1M4 7l2-1M4 7l2 1M4 7v2.5M12 21l-2-1m2 1l2-1m-2 1v-2.5M6 18l-2-1v-2.5M18 18l2-1v-2.5"
                        ></path></svg
                    >
                </div>
                <h3 class="text-xl font-bold text-white mb-3">
                    Motor Unity 3D
                </h3>
                <p class="text-slate-400 leading-relaxed">
                    Desarrollado con uno de los motores gráficos más potentes
                    para ofrecer físicas realistas, colisiones precisas y
                    gráficos envolventes.
                </p>
            </div>

            <!-- Feature 2 -->
            <div
                class="bg-slate-800/40 border border-slate-700/50 p-8 rounded-3xl backdrop-blur-sm hover:bg-slate-800/60 hover:-translate-y-2 transition-all duration-300 group shadow-lg"
            >
                <div
                    class="w-14 h-14 bg-cyan-500/20 rounded-2xl flex items-center justify-center text-cyan-400 mb-6 group-hover:scale-110 transition-transform"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg
                    >
                </div>
                <h3 class="text-xl font-bold text-white mb-3">
                    Análisis en Tiempo Real
                </h3>
                <p class="text-slate-400 leading-relaxed">
                    Cada disparo y test realizado en el juego se sincroniza con
                    Firebase, permitiendo a los profesores visualizar
                    estadísticas al instante.
                </p>
            </div>

            <!-- Feature 3 -->
            <div
                class="bg-slate-800/40 border border-slate-700/50 p-8 rounded-3xl backdrop-blur-sm hover:bg-slate-800/60 hover:-translate-y-2 transition-all duration-300 group shadow-lg"
            >
                <div
                    class="w-14 h-14 bg-teal-500/20 rounded-2xl flex items-center justify-center text-teal-400 mb-6 group-hover:scale-110 transition-transform"
                >
                    <svg
                        class="w-7 h-7"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
                        ></path></svg
                    >
                </div>
                <h3 class="text-xl font-bold text-white mb-3">
                    Aprendizaje Práctico
                </h3>
                <p class="text-slate-400 leading-relaxed">
                    Poner en práctica fórmulas de velocidad inicial, ángulo de
                    elevación y gravedad nunca fue tan entretenido para los
                    estudiantes.
                </p>
            </div>
        </div>
    </section>

    <!-- CTA Footer -->
    <section
        class="max-w-4xl mx-auto px-4 py-16 md:py-20 text-center relative z-10"
    >
        <div
            class="bg-gradient-to-b from-slate-800/80 to-slate-900/80 backdrop-blur-md rounded-3xl p-10 md:p-16 border border-slate-700 shadow-2xl relative overflow-hidden"
        >
            <!-- Elemento decorativo sutil -->
            <div
                class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-indigo-500 via-cyan-400 to-teal-400"
            >
            </div>

            <h2 class="text-3xl font-bold text-white mb-6">
                ¿Listo para calcular tu primer disparo?
            </h2>
            <p class="text-slate-400 mb-8 max-w-xl mx-auto text-lg">
                Ingresa a nuestra página en itch.io, y empieza a desafiar las
                leyes de la física con nuestro simulador.
            </p>
            <a
                href="https://piper-ka.itch.io/proyectofisica"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block px-10 py-4 bg-white text-slate-900 hover:bg-slate-200 font-bold rounded-xl transition-colors shadow-lg hover:shadow-white/20"
            >
                Jugar Ahora Gratis
            </a>
        </div>
    </section>
</Layout>
