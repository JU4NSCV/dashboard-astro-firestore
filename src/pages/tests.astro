---
import Layout from "../layouts/Layout.astro";
import { db } from "../lib/firebase";
import { collection, getDocs } from "firebase/firestore";

// 1. Obtenemos todos los documentos de la colección 'usuarios'
const usuariosSnapshot = await getDocs(collection(db, "usuarios"));
const listaUsuarios = usuariosSnapshot.docs.map(doc => {
  const data = doc.data();
  const idUsuario = doc.id;
  
  // 1. Entramos a ultimoTest
  const infoUltimoTest = data.ultimoTest || {};
  
  // 2. Entramos al mapa 'tests' que está dentro de ultimoTest
  const mapaDeExamenes = infoUltimoTest.tests || {};

  // 3. Iteramos sobre test1, test2, etc.
  const testsFiltrados = Object.entries(mapaDeExamenes)
    .filter(([key, value]) => key.startsWith('test') && typeof value === 'object')
    .map(([key, value]) => ({
      nombreTest: key.replace('test', 'Test '),
      aciertos: value.aciertos ?? 0,
      errores: value.errores ?? 0,
      completado: value.completado ?? false
    }));

  return {
    idUsuario,
    tests: testsFiltrados 
  };
});
---

<Layout title="Dashboard Usuarios">
  <div class="max-w-7xl mx-auto p-4 md:p-8 space-y-10">
    
    <!-- Encabezado Principal -->
    <header class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 bg-white/5 p-8 rounded-3xl border border-white/10 backdrop-blur-xl shadow-2xl relative overflow-hidden">
      <!-- Decoración de fondo -->
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-indigo-500/20 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-cyan-500/20 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10">
        <h1 class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-cyan-400 to-teal-300">
          Panel de Usuarios
        </h1>
        <p class="text-slate-400 mt-2 text-lg">Supervisa el progreso y rendimiento de todos los estudiantes</p>
      </div>
      <div class="relative z-10 flex items-center gap-3 bg-slate-900/50 py-2 px-4 rounded-full border border-slate-700/50">
        <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
        <span class="text-sm font-medium text-slate-300">{listaUsuarios.length} Usuarios Registrados</span>
      </div>
    </header>

    <!-- Lista de Usuarios -->
    <div class="grid grid-cols-1 gap-8">
      {listaUsuarios.map((user) => (
        <div class="bg-slate-800/40 rounded-3xl border border-slate-700/50 shadow-2xl backdrop-blur-sm overflow-hidden hover:border-indigo-500/30 transition-all duration-500 group">
          
          <!-- Header de Tarjeta de Usuario -->
          <div class="bg-gradient-to-r from-slate-900/80 to-slate-800/80 p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-b border-slate-700/50">
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-br from-indigo-500 to-cyan-500 flex items-center justify-center text-xl font-bold text-white shadow-lg shadow-indigo-500/20 transform group-hover:scale-105 transition-transform duration-300">
                {user.idUsuario.charAt(0).toUpperCase()}
              </div>
              <div>
                <h2 class="text-white font-bold text-xl">{user.idUsuario}</h2>
              </div>
            </div>
            
            <div class="flex flex-col items-end">
              <span class="text-sm text-slate-400">Total de Tests Completados</span>
              <span class="text-2xl font-bold text-white">
                {user.tests.filter(t => t.completado).length} <span class="text-slate-500 text-lg">/ {user.tests.length || 0}</span>
              </span>
            </div>
          </div>

          <!-- Contenido de Tests -->
          <div class="p-6">
            {user.tests.length > 0 ? (
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5 gap-5">
                {user.tests.map((t) => (
                  <div class="relative bg-slate-900/60 rounded-2xl p-5 border border-slate-700/50 hover:bg-slate-800/80 transition-colors duration-300 flex flex-col justify-between overflow-hidden">
                    
                    <!-- Efecto de brillo condicional si está completado -->
                    {t.completado && (
                      <div class="absolute -right-4 -top-4 w-16 h-16 bg-green-500/10 rounded-full blur-2xl"></div>
                    )}

                    <div>
                      <div class="flex justify-between items-start mb-4">
                        <span class="text-sm font-bold tracking-wider uppercase text-slate-300">{t.nombreTest}</span>
                        <div class={`px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider flex items-center gap-1.5 ${t.completado ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 'bg-amber-500/10 text-amber-400 border border-amber-500/20'}`}>
                          <div class={`w-1.5 h-1.5 rounded-full ${t.completado ? 'bg-green-400 shadow-[0_0_5px_#4ade80]' : 'bg-amber-400'}`}></div>
                          {t.completado ? 'Finalizado' : 'Progreso'}
                        </div>
                      </div>
                      
                      <div class="space-y-3">
                        <!-- Aciertos -->
                        <div class="flex items-center justify-between bg-green-500/5 rounded-xl p-2.5 border border-green-500/10">
                          <div class="flex items-center gap-2 text-green-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            <span class="text-xs font-medium">Aciertos</span>
                          </div>
                          <span class="font-bold text-green-400 text-lg">{t.aciertos}</span>
                        </div>
                        
                        <!-- Errores -->
                        <div class="flex items-center justify-between bg-red-500/5 rounded-xl p-2.5 border border-red-500/10">
                          <div class="flex items-center gap-2 text-red-400">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                            <span class="text-xs font-medium">Errores</span>
                          </div>
                          <span class="font-bold text-red-400 text-lg">{t.errores}</span>
                        </div>
                      </div>
                    </div>
                    
                    <!-- Progress Bar Simulado -->
                    <div class="mt-5 w-full bg-slate-800 rounded-full h-1.5 overflow-hidden">
                      <div 
                        class={`h-1.5 rounded-full ${t.completado ? 'bg-green-500' : 'bg-gradient-to-r from-amber-500 to-amber-300'}`} 
                        style={`width: ${t.completado ? '100%' : Math.min(100, Math.max(10, (t.aciertos / (t.aciertos + t.errores || 1)) * 100))}%`}
                      ></div>
                    </div>

                  </div>
                ))}
              </div>
            ) : (
              <div class="flex flex-col items-center justify-center py-10 bg-slate-900/30 rounded-2xl border border-dashed border-slate-700">
                <div class="w-16 h-16 bg-slate-800 rounded-full flex items-center justify-center mb-4">
                  <svg class="w-8 h-8 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                </div>
                <p class="text-slate-400 text-lg font-medium">Sin datos de tests</p>
                <p class="text-slate-500 text-sm mt-1">Este usuario aún no ha iniciado ninguna prueba.</p>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>