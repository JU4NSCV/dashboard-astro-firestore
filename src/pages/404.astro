---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Página no encontrada | DatosFísica" noindex>
    <section class="max-w-xl mx-auto px-4 py-24 text-center">
        <p class="text-sm font-semibold tracking-wider text-cyan-400 uppercase">Error 404</p>
        <h1 class="mt-4 text-4xl md:text-5xl font-extrabold text-white">Este disparo no dio en el blanco</h1>
        <p class="mt-6 text-slate-400 text-lg">La página que buscas no existe o fue movida.</p>
        <a
            href="/"
            class="inline-block mt-10 px-8 py-3 bg-white text-slate-900 hover:bg-slate-200 font-bold rounded-xl transition-colors"
            >Volver al inicio</a
        >
    </section>
</Layout>
