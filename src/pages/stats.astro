---
import Layout from "../layouts/Layout.astro";
import { db } from "../lib/firebase";
import { collection, getDocs } from "firebase/firestore";

// 1. Obtener datos básicos
const usuariosSnapshot = await getDocs(collection(db, "usuarios"));

// --- LÓGICA DE PROCESAMIENTO DE ESTADÍSTICAS ---

const stats = {
    total: usuariosSnapshot.size,
    aprobados: 0, // Pasaron 4 o 5 tests
    enProgreso: 0, // Pasaron 1 a 3 tests
    reprobados: 0, // 0 tests pasados o más errores que aciertos
    porFecha: {}, // { "2024-05-07": 5 usuarios }
};

usuariosSnapshot.forEach((doc) => {
    const data = doc.data();

    // A. Procesar Fecha de Registro/Actualización
    // Usamos 'actualizadoEn' como referencia de actividad
    if (data.actualizadoEn) {
        const fecha = data.actualizadoEn.toDate().toISOString().split("T")[0];
        stats.porFecha[fecha] = (stats.porFecha[fecha] || 0) + 1;
    }

    // B. Procesar Rendimiento
    const mapaDeExamenes = data.ultimoTest?.tests || {};
    const tests = Object.values(mapaDeExamenes);

    // Definimos un test "ganado" si tiene más aciertos que errores y está completado
    const testsPasados = tests.filter(
        (t: any) => t.completado && t.aciertos > t.errores,
    ).length;

    if (testsPasados >= 4) {
        stats.aprobados++;
    } else if (testsPasados >= 1) {
        stats.enProgreso++;
    } else {
        stats.reprobados++;
    }
});

// Ordenar fechas para la gráfica/lista (de más reciente a más antigua)
const fechasOrdenadas = Object.entries(stats.porFecha).sort(
    (a, b) => new Date(b[0]).getTime() - new Date(a[0]).getTime(),
);
---

<Layout title="Estadísticas Globales">
    <div class="max-w-7xl mx-auto p-4 md:p-8 space-y-8">
        <section
            class="relative p-8 rounded-3xl bg-slate-900/50 border border-white/10 overflow-hidden shadow-2xl"
        >
            <div
                class="absolute -top-10 -left-10 w-40 h-40 bg-indigo-600/20 rounded-full blur-3xl"
            >
            </div>
            <div class="relative z-10">
                <h1 class="text-4xl font-black text-white tracking-tight">
                    Estadísticas del Sistema
                </h1>
                <p class="text-slate-400 mt-2">
                    Análisis de rendimiento y crecimiento de la comunidad de
                    tiro.
                </p>
            </div>
        </section>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <div
                class="bg-slate-800/40 p-6 rounded-3xl border border-slate-700/50 backdrop-blur-md"
            >
                <p
                    class="text-slate-400 text-sm font-semibold uppercase tracking-wider"
                >
                    Total Usuarios
                </p>
                <div class="flex items-end justify-between mt-2">
                    <span class="text-4xl font-bold text-white"
                        >{stats.total}</span
                    >
                    <div
                        class="p-2 bg-indigo-500/20 rounded-lg text-indigo-400"
                    >
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"
                            ></path></svg
                        >
                    </div>
                </div>
            </div>

            <div
                class="bg-slate-800/40 p-6 rounded-3xl border border-green-500/20 backdrop-blur-md"
            >
                <p
                    class="text-green-400/80 text-sm font-semibold uppercase tracking-wider"
                >
                    Aprobación (4+ tests)
                </p>
                <div class="flex items-end justify-between mt-2">
                    <span class="text-4xl font-bold text-white"
                        >{stats.aprobados}</span
                    >
                    <div class="p-2 bg-green-500/20 rounded-lg text-green-400">
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
                            ></path></svg
                        >
                    </div>
                </div>
            </div>

            <div
                class="bg-slate-800/40 p-6 rounded-3xl border border-amber-500/20 backdrop-blur-md"
            >
                <p
                    class="text-amber-400/80 text-sm font-semibold uppercase tracking-wider"
                >
                    En Progreso (1-3 tests)
                </p>
                <div class="flex items-end justify-between mt-2">
                    <span class="text-4xl font-bold text-white"
                        >{stats.enProgreso}</span
                    >
                    <div class="p-2 bg-amber-500/20 rounded-lg text-amber-400">
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
                        >
                    </div>
                </div>
            </div>

            <div
                class="bg-slate-800/40 p-6 rounded-3xl border border-red-500/20 backdrop-blur-md"
            >
                <p
                    class="text-red-400/80 text-sm font-semibold uppercase tracking-wider"
                >
                    Críticos (0 tests)
                </p>
                <div class="flex items-end justify-between mt-2">
                    <span class="text-4xl font-bold text-white"
                        >{stats.reprobados}</span
                    >
                    <div class="p-2 bg-red-500/20 rounded-lg text-red-400">
                        <svg
                            class="w-6 h-6"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                            ></path></svg
                        >
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <div
                class="bg-slate-900/50 p-8 rounded-3xl border border-slate-700/50 shadow-xl"
            >
                <h3
                    class="text-xl font-bold text-white mb-6 flex items-center gap-2"
                >
                    <svg
                        class="w-5 h-5 text-indigo-400"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        ><path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        ></path></svg
                    >
                    Usuarios por Fecha
                </h3>
                <div
                    class="space-y-4 max-h-[400px] overflow-y-auto pr-2 custom-scrollbar"
                >
                    {
                        fechasOrdenadas.map(([fecha, cantidad]) => (
                            <div class="flex items-center justify-between p-4 rounded-2xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors">
                                <span class="text-slate-300 font-medium">
                                    {new Date(fecha).toLocaleDateString(
                                        "es-ES",
                                        {
                                            day: "numeric",
                                            month: "long",
                                            year: "numeric",
                                        },
                                    )}
                                </span>
                                <span class="px-4 py-1 rounded-full bg-indigo-500/20 text-indigo-300 text-sm font-bold">
                                    {cantidad}{" "}
                                    {cantidad === 1 ? "usuario" : "usuarios"}
                                </span>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div
                class="bg-slate-900/50 p-8 rounded-3xl border border-slate-700/50 shadow-xl flex flex-col"
            >
                <h3 class="text-xl font-bold text-white mb-6">
                    Visualización de Rendimiento
                </h3>

                <div class="flex-1 flex flex-col justify-center space-y-8">
                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="text-green-400 font-bold"
                                >Aprobados (Mayoria/Todo)</span
                            >
                            <span class="text-white"
                                >{
                                    Math.round(
                                        (stats.aprobados / stats.total) * 100,
                                    )
                                }%</span
                            >
                        </div>
                        <div class="w-full bg-slate-800 rounded-full h-4">
                            <div
                                class="bg-green-500 h-4 rounded-full shadow-[0_0_15px_rgba(34,197,94,0.4)]"
                                style={`width: ${(stats.aprobados / stats.total) * 100}%`}
                            >
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="text-amber-400 font-bold"
                                >En Progreso</span
                            >
                            <span class="text-white"
                                >{
                                    Math.round(
                                        (stats.enProgreso / stats.total) * 100,
                                    )
                                }%</span
                            >
                        </div>
                        <div class="w-full bg-slate-800 rounded-full h-4">
                            <div
                                class="bg-amber-500 h-4 rounded-full shadow-[0_0_15px_rgba(245,158,11,0.4)]"
                                style={`width: ${(stats.enProgreso / stats.total) * 100}%`}
                            >
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <div class="flex justify-between text-sm">
                            <span class="text-red-400 font-bold"
                                >Reprobados / Sin actividad</span
                            >
                            <span class="text-white"
                                >{
                                    Math.round(
                                        (stats.reprobados / stats.total) * 100,
                                    )
                                }%</span
                            >
                        </div>
                        <div class="w-full bg-slate-800 rounded-full h-4">
                            <div
                                class="bg-red-500 h-4 rounded-full shadow-[0_0_15px_rgba(239,68,68,0.4)]"
                                style={`width: ${(stats.reprobados / stats.total) * 100}%`}
                            >
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .custom-scrollbar::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: rgba(99, 102, 241, 0.3);
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: rgba(99, 102, 241, 0.5);
    }
</style>
