# Configuración web de Firebase (Consola > Configuración del proyecto > Tus apps).
# Son valores públicos: se incluyen en el JavaScript del navegador.
PUBLIC_FIREBASE_API_KEY="tu_api_key"
PUBLIC_FIREBASE_AUTH_DOMAIN="tu_proyecto.firebaseapp.com"
PUBLIC_FIREBASE_PROJECT_ID="tu_project_id"
PUBLIC_FIREBASE_STORAGE_BUCKET="tu_proyecto.firebasestorage.app"
PUBLIC_FIREBASE_MESSAGING_SENDER_ID="tu_messaging_sender_id"
PUBLIC_FIREBASE_APP_ID="tu_app_id"
PUBLIC_FIREBASE_MEASUREMENT_ID="tu_measurement_id"

# SECRETO (solo servidor). Firma la cookie de sesión del panel. Mínimo 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="cambia_esto_por_un_valor_aleatorio_de_al_menos_32_caracteres"
